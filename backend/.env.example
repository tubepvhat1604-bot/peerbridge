# Backend chạy trên máy: cd backend; python run.py (chỉ đọc backend/.env ở thư mục này).
# Biến môi trường của tiến trình được ưu tiên hơn file .env. Sửa xong thì khởi động lại.
# Không commit file .env thật.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=./data/peerbridge.db
UPLOAD_DIRECTORY=./data/uploads
# Khóa ký token đăng nhập. Bắt buộc; production dùng chuỗi ngẫu nhiên dài.
JWT_SECRET=local-dev-only-change-me
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000


# ---- AI (để trống key thì mọi phần AI chạy bằng luật và mẫu có sẵn) ----
OPENAI_API_KEY=
# Phòng học (moderator): openai | fake
LLM_PROVIDER=fake
# Check-in ảnh (AI Vision): openai | fake
VISION_LLM_PROVIDER=fake
# Trần chi phí AI chung mỗi ngày, USD
VISION_DAILY_BUDGET_USD=2
# Kế hoạch tuần: template (không gọi AI) | openai_compatible
PLAN_LLM_PROVIDER=template
PLAN_CATALOG_PATH=data/concepts/plan_catalog.json
PLAN_COACH_V2_ENABLED=true

# ---- RAG cho phòng học ----
# local: BM25 trên data/courses/<course_id>/*.md | fake: không tra tài liệu
RETRIEVER_PROVIDER=local
# Khóa tài liệu dùng khi phòng học chưa gán khóa nào; để trống = không tra tài liệu
RAG_DEFAULT_COURSE_ID=demo-course

# ---- Các biến sau chỉ đọc từ biến môi trường của tiến trình, KHÔNG đọc từ file này ----
# DEMO_MODE=true              bạn học mẫu và nút "Vào thử: Lan / Minh / Admin"
# ADMIN_EMAILS=a@x.com,b@y.com email được vào trang Admin
# MATCH_RERANK_ENABLED=true   AI xếp lại kết quả ghép cặp (cần OPENAI_API_KEY)
# LOOP_INTERVAL_MINUTES=60    chu kỳ đo nhịp học và coach; 0 = tắt
